# ==========================================
# AWS 認証情報（Bedrock / Polly などで使用）
# ==========================================
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_DEFAULT_REGION=us-east-1

# 一時クレデンシャルを使用する場合はセッショントークンも指定
# AWS_SESSION_TOKEN=...

# AWS CLI プロファイルを使用する場合（アクセスキーとの併用は不要）
# AWS_PROFILE=default

# ==========================================
# サーバー設定
# ==========================================
# アプリケーションがリッスンするポート（デフォルト 3001）
PORT=3001

# Vonage / Web ブラウザ連携の有効化フラグ
VONAGE_ENABLED=true
BROWSER_ENABLED=true

# ==========================================
# Vonage / EC2 関連（CDK デプロイ・運用で使用）
# ==========================================
# ALB / EC2 に紐付けるドメイン名（SSL 証明書発行に使用）
SERVER_URL=your-domain.example.com

# SSH アクセス制限に使用するクライアントのグローバル IP（例: 1.2.3.4/32）
MY_IP=1.2.3.4/32

# EC2 インスタンス作成に使用するキーペア名
EC2_KEY_PAIR_NAME=your-key-pair-name
